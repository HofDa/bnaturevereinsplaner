# Copy to .env; generate independent random values, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
POSTGRES_PORT=55439
TEST_POSTGRES_PASSWORD=replace-with-another-random-hex-password
DATABASE_URL=postgres://bnature:replace-with-a-long-random-hex-password@127.0.0.1:55439/bnature
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_URL=http://localhost:5173
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
# Private document files (outside any web root; include in backups). Default: .local/documents
DOCUMENT_STORAGE_DIR=.local/documents
NODE_ENV=development
# Local email inbox: docker compose --profile mail up -d mailpit
# EMAIL_MODE=local captures all mail at http://localhost:8025 (no external delivery).
EMAIL_MODE=disabled
EMAIL_FROM=noreply@bnature.test
# Production: EMAIL_MODE=smtp, real sender, TLS-capable SMTP provider.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Error reports: unexpected failures of app and server are collected under Aktivitätsprotokoll.
# Optional e-mail to the operator when a new problem appears (needs EMAIL_MODE local/smtp).
# ERROR_ALERT_EMAIL=admin@example.org
# Optional label shown with reports, e.g. a version or commit; set at build time and runtime.
# APP_RELEASE=
# Push notifications (optional). Generate one key pair per installation and keep it:
#   bunx web-push generate-vapid-keys
# Replacing the keys later invalidates every device subscription. Empty = feature off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for the push services; default mailto:EMAIL_FROM. Use a real address in production.
# VAPID_SUBJECT=mailto:admin@example.org
# Production: public hostname, without scheme; APP_URL=https://your-hostname.
DOMAIN=verein.example.org
# Optional only for initial CLI bootstrap; remove immediately afterward.
# BOOTSTRAP_NAME=Name
# BOOTSTRAP_EMAIL=admin@example.org
# BOOTSTRAP_PASSWORD=provide-via-a-secret-manager-or-use-the-generated-password
