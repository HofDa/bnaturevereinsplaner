# Copy to .env; generate independent random values, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
POSTGRES_PORT=55439
TEST_POSTGRES_PASSWORD=replace-with-another-random-hex-password
DATABASE_URL=postgres://bnature:replace-with-a-long-random-hex-password@127.0.0.1:55439/bnature
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_URL=http://localhost:5173
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
# Private document files (outside any web root; include in backups). Default: .local/documents
DOCUMENT_STORAGE_DIR=.local/documents
NODE_ENV=development
# Production: public hostname, without scheme; APP_URL=https://your-hostname.
DOMAIN=verein.example.org
# Optional only for initial CLI bootstrap; remove immediately afterward.
# BOOTSTRAP_NAME=Name
# BOOTSTRAP_EMAIL=admin@example.org
# BOOTSTRAP_PASSWORD=provide-via-a-secret-manager-or-use-the-generated-password
